# ---- Wajib ----
# Lokal (docker compose): kedua URL sama.
DATABASE_URL="postgresql://bwi:bwi@127.0.0.1:55433/bwi_sim?schema=public"
DIRECT_URL="postgresql://bwi:bwi@127.0.0.1:55433/bwi_sim?schema=public"
#
# Supabase (Project Settings → Database → Connect):
#   DATABASE_URL = Transaction pooler, port 6543, tambahkan ?pgbouncer=true&connection_limit=5&sslmode=require
#     postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&sslmode=require
#   DIRECT_URL   = Session pooler, port 5432 (dipakai migrasi Prisma & LISTEN real-time)
#     postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#   Boleh juga memakai Session pooler untuk keduanya (paling sederhana untuk 1 server Node).
# DB_SSL_CA_PATH="./supabase-ca.crt"   # opsional: verifikasi sertifikat SSL (unduh CA dari Supabase)
APP_URL="http://localhost:3100"          # dipakai untuk link di email (magic link, invoice)
AUTH_SECRET="ganti-dengan-string-acak-min-32-karakter"
TOKEN_PEPPER="ganti-dengan-string-acak-lain"   # dicampur saat hash token magic link
JOB_SECRET="ganti-secret-untuk-endpoint-cron"
TZ="Asia/Jakarta"

# ---- Email (SMTP). Dev: Mailpit dari docker-compose, UI di http://localhost:8026 ----
SMTP_URL="smtp://127.0.0.1:1026"

# ---- Penyimpanan dokumen ----
STORAGE_DRIVER="local"                   # local | s3
STORAGE_LOCAL_DIR="./storage"
STORAGE_ENCRYPTION_KEY="base64-32-byte-key"  # openssl rand -base64 32 (enkripsi at-rest driver local)
# Lokal: "local" — file terenkripsi di disk (STORAGE_LOCAL_DIR). Supabase Storage TIDAK dipakai.
# Vercel (produksi): WAJIB "s3" dengan Cloudflare R2:
#   STORAGE_DRIVER="s3"
#   S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
#   S3_REGION="auto"
#   S3_BUCKET="bwi-docs"
#   (+ CORS PUT dari domain aplikasi & lifecycle hapus "incoming/" 1 hari — lihat README)
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_SSE=""                                # "AES256" untuk AWS S3/MinIO; kosongkan untuk R2

# ---- Cron internal (node-cron di proses Next). Matikan jika memakai Vercel Cron / pg_cron ----
ENABLE_INTERNAL_CRON="true"   # false di Vercel (pakai Vercel Cron di vercel.json)
CRON_SECRET=""                # Vercel: string acak; dikirim Vercel Cron sebagai Authorization: Bearer
